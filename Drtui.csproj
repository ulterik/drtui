<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Drtui.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.53.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="schemas/drp.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>